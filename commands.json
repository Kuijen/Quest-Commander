    {
      "title": "Screen Recording",
      "children": [
        {
          "title": "Recording Controls",
          "children": [
            {
              "title": "Start Recording",
              "commands": [
                "adb shell setprop debug.oculus.enableVideoCapture 1"
              ]
            },
            {
              "title": "Stop Recording",
              "commands": [
                "adb shell setprop debug.oculus.enableVideoCapture 0"
              ]
            }
          ]
        },
        {
          "title": "Capture Resolution",
          "children": [
            {
              "title": "Default - 1024 x 1024",
              "commands": [
                "adb shell setprop debug.oculus.capture.width 1024",
                "adb shell setprop debug.oculus.capture.height 1024"
              ]
            },
            {
              "title": "Full HD - 1920 x 1080",
              "commands": [
                "adb shell setprop debug.oculus.capture.width 1920",
                "adb shell setprop debug.oculus.capture.height 1080"
              ]
            },
            {
              "title": "Max (community-reported) - 1920 x 2160",
              "commands": [
                "adb shell setprop debug.oculus.capture.width 1920",
                "adb shell setprop debug.oculus.capture.height 2160"
              ]
            }
          ]
        },
        {
          "title": "Capture Framerate",
          "children": [
            {
              "title": "Half Refresh Rate (default)",
              "commands": [
                "adb shell setprop debug.oculus.fullRateCapture 0"
              ]
            },
            {
              "title": "Full Refresh Rate",
              "commands": [
                "adb shell setprop debug.oculus.fullRateCapture 1"
              ]
            },
            {
              "title": "Force 60 FPS (community property, unconfirmed on all firmware)",
              "commands": [
                "adb shell setprop debug.oculus.capture.fps 60"
              ]
            },
            {
              "title": "Force 90 FPS (community property, unconfirmed on all firmware)",
              "commands": [
                "adb shell setprop debug.oculus.capture.fps 90"
              ]
            }
          ]
        },
        {
          "title": "Capture Bitrate",
          "children": [
            {
              "title": "Default - 5 Mbps",
              "commands": [
                "adb shell setprop debug.oculus.capture.bitrate 5000000"
              ]
            },
            {
              "title": "High - 30 Mbps",
              "commands": [
                "adb shell setprop debug.oculus.capture.bitrate 30000000"
              ]
            },
            {
              "title": "Max - 50 Mbps",
              "commands": [
                "adb shell setprop debug.oculus.capture.bitrate 50000000"
              ]
            }
          ]
        },
        {
          "title": "Combined Presets",
          "children": [
            {
              "title": "Max Recording Quality (1920x1080, Full Rate, 50 Mbps)",
              "commands": [
                "adb shell setprop debug.oculus.capture.width 1920",
                "adb shell setprop debug.oculus.capture.height 1080",
                "adb shell setprop debug.oculus.fullRateCapture 1",
                "adb shell setprop debug.oculus.capture.bitrate 50000000"
              ]
            },
            {
              "title": "Reset to Defaults (1024x1024, Half Rate, 5 Mbps)",
              "commands": [
                "adb shell setprop debug.oculus.capture.width 1024",
                "adb shell setprop debug.oculus.capture.height 1024",
                "adb shell setprop debug.oculus.fullRateCapture 0",
                "adb shell setprop debug.oculus.capture.bitrate 5000000"
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Device Utilities",
      "children": [
        {
          "title": "List Connected Devices",
          "commands": [
            "adb devices"
          ]
        },
        {
          "title": "Show Current Oculus Props",
          "commands": [
            "adb shell \"getprop | grep oculus\""
          ]
        },
        {
          "title": "Reboot Headset",
          "commands": [
            "adb reboot"
          ]
        },
        {
          "title": "Proximity Sensor",
          "children": [
            {
              "title": "Disable (keep display on when not worn)",
              "commands": [
                "adb shell am broadcast -a com.oculus.vrpowermanager.prox_close"
              ]
            },
            {
              "title": "Enable (restore normal sensor behavior)",
              "commands": [
                "adb shell am broadcast -a com.oculus.vrpowermanager.automation_disable"
              ]
            }
          ]
        },
        {
          "title": "Boundary (Guardian)",
          "children": [
            {
              "title": "Disable Boundary",
              "commands": [
                "adb shell setprop debug.oculus.guardian_pause 1"
              ]
            },
            {
              "title": "Enable Boundary",
              "commands": [
                "adb shell setprop debug.oculus.guardian_pause 0"
              ]
            }
          ]
        }
      ]
    }
  ]
}
