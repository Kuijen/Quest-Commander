{
  "title": "Quest Commander",
  "children": [
    {
      "title": "Meta Quest 1",
      "children": [
        {
          "title": "Refresh Rate",
          "children": [
            {
              "title": "60 Hz (media apps only)",
              "commands": [
                "adb shell setprop debug.oculus.refreshRate 60"
              ]
            },
            {
              "title": "72 Hz (default)",
              "commands": [
                "adb shell setprop debug.oculus.refreshRate 72"
              ]
            }
          ]
        },
        {
          "title": "Resolution (per-eye render target)",
          "children": [
            {
              "title": "75% - 912 x 1008",
              "commands": [
                "adb shell setprop debug.oculus.textureWidth 912",
                "adb shell setprop debug.oculus.textureHeight 1008"
              ]
            },
            {
              "title": "100% Native - 1216 x 1344",
              "commands": [
                "adb shell setprop debug.oculus.textureWidth 1216",
                "adb shell setprop debug.oculus.textureHeight 1344"
              ]
            },
            {
              "title": "125% Supersample - 1520 x 1680",
              "commands": [
                "adb shell setprop debug.oculus.textureWidth 1520",
                "adb shell setprop debug.oculus.textureHeight 1680"
              ]
            }
          ]
        },
        {
          "title": "GPU / CPU Levels",
          "children": [
            {
              "title": "Max Performance (CPU 4 / GPU 4)",
              "commands": [
                "adb shell setprop debug.oculus.cpuLevel 4",
                "adb shell setprop debug.oculus.gpuLevel 4"
              ]
            },
            {
              "title": "Balanced (CPU 2 / GPU 2)",
              "commands": [
                "adb shell setprop debug.oculus.cpuLevel 2",
                "adb shell setprop debug.oculus.gpuLevel 2"
              ]
            },
            {
              "title": "Battery Saver (CPU 0 / GPU 0)",
              "commands": [
                "adb shell setprop debug.oculus.cpuLevel 0",
                "adb shell setprop debug.oculus.gpuLevel 0"
              ]
            }
          ]
        },
        {
          "title": "Fixed Foveated Rendering",
          "children": [
            {
              "title": "Off",
              "commands": [
                "adb shell setprop debug.oculus.foveation.dynamic 0",
                "adb shell setprop debug.oculus.foveation.level 0"
              ]
            },
            {
              "title": "Low",
              "commands": [
                "adb shell setprop debug.oculus.foveation.dynamic 0",
                "adb shell setprop debug.oculus.foveation.level 1"
              ]
            },
            {
              "title": "Medium",
              "commands": [
                "adb shell setprop debug.oculus.foveation.dynamic 0",
                "adb shell setprop debug.oculus.foveation.level 2"
              ]
            },
            {
              "title": "High",
              "commands": [
                "adb shell setprop debug.oculus.foveation.dynamic 0",
                "adb shell setprop debug.oculus.foveation.level 3"
              ]
            },
            {
              "title": "High Top",
              "commands": [
                "adb shell setprop debug.oculus.foveation.dynamic 0",
                "adb shell setprop debug.oculus.foveation.level 4"
              ]
            }
          ]
        },
        {
          "title": "Combined Presets",
          "children": [
            {
              "title": "High Quality (72Hz, Native res, Max GPU/CPU, No Foveation)",
              "commands": [
                "adb shell setprop debug.oculus.refreshRate 72",
                "adb shell setprop debug.oculus.textureWidth 1216",
                "adb shell setprop debug.oculus.textureHeight 1344",
                "adb shell setprop debug.oculus.cpuLevel 4",
                "adb shell setprop debug.oculus.gpuLevel 4",
                "adb shell setprop debug.oculus.foveation.dynamic 0",
                "adb shell setprop debug.oculus.foveation.level 0"
              ]
            },
            {
              "title": "Battery Saver (72Hz, 75% res, Low GPU/CPU, High Foveation)",
